# ─────────────────────────────────────────────────────────────────────────────
# Event microsite env vars
#
# Copy to .env.local for local dev, or set in Vercel Project Settings for
# deployments. `.env.local` is gitignored.
#
# Access everything through lib/env.ts, never process.env directly.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from Supabase Dashboard → Settings → API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx...   # NEVER expose to the client

# Optional — reserved for future client-side reads of non-sensitive data.
SUPABASE_ANON_KEY=eyJxxxxxxxx...

# Public mirrors of the URL + assets bucket, safe to read in the browser.
# Used by lib/assets.ts to resolve ImageSlot src values from Supabase Storage.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ASSETS_BUCKET=event-assets

# ─── Auth (magic-link login + session cookies) ───────────────────────────────
# 32+ bytes of randomness. Rotating this logs out EVERY attendee on
# EVERY event — it's the emergency "log everyone out" lever.
# Generate with: openssl rand -hex 32
#
# Historical note: RSVP_TOKEN_SECRET used to live here too, for signing
# RSVP edit-link tokens. Retired in migration 0003 once full-site
# magic-link auth made the separate edit-token redundant.
AUTH_TOKEN_SECRET=change-me

# ─── Feedback (embedded Tally form) ──────────────────────────────────────────
# HMAC secret for the pseudonymous respondent tokens passed to the Tally
# feedback embed as a hidden field (lib/feedback/respondent.ts). Dedicated
# secret so rotating AUTH_TOKEN_SECRET never breaks the ability to match
# historical feedback tokens back to attendees. Server-only.
# Generate with: openssl rand -hex 32
FEEDBACK_RESPONDENT_SECRET=change-me

# Signing secret from the Tally form's webhook settings (Integrations →
# Webhooks). Verifies the HMAC on POST /api/webhooks/tally; the route
# fails closed (500) when unset and Tally's retry schedule re-delivers
# once it lands. Staging and production point at SEPARATE Tally forms,
# so each scope gets its own secret. One secret per environment: when
# several events each have their own Tally form, configure every form's
# webhook with this same value (per-form secrets would need a
# formId→secret map in lib/env.ts — see the accessor comment). Server-only.
TALLY_SIGNING_SECRET=change-me

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# https://resend.com/api-keys — domain must be verified.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=events@yourdomain.com

# ─── Scheduled jobs (retention purge) ────────────────────────────────────────
# Shared secret that Vercel Cron sends in the Authorization: Bearer header
# when hitting /api/cron/purge-retention. Also used by operators running
# the purge manually via curl. Server-only.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Optional. When set, lib/rate-limit.ts uses Upstash's sliding-window
# limiter over Redis REST; otherwise it falls back to an in-process store.
# The in-process fallback is fine for local dev and single-instance
# deploys, but does NOT share state across serverless cold starts or
# regions — set both vars in production (Vercel, Cloudflare, etc.).
#
# Create a free Redis DB at https://console.upstash.com, then copy:
#   - "UPSTASH_REDIS_REST_URL"   — HTTPS endpoint, not the redis:// URL
#   - "UPSTASH_REDIS_REST_TOKEN" — the read/write token (server-only)
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxxxxxxxxxxxxxxxxxxxQ==

# ─── Internal access gate ────────────────────────────────────────────────────
# Organizer access to /internal/* and /api/internal/* is now session-based
# via invited_attendees.role = 'organizer'. There are no INTERNAL_BASIC_*
# env vars any more. To grant organizer access:
#   1. add the email to events/<slug>/invites.ts with role: "organizer"
#   2. run scripts/seed-invites.ts <slug>
#   3. the organizer signs in via /login/<slug> like any other attendee

# ─── Public site URL ─────────────────────────────────────────────────────────
# Origin used to build absolute links in emails. Do not include a path.
# On Vercel preview deploys, VERCEL_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=https://events.example.com

# ─── Draft preview mode (optional, M4-B) ────────────────────────────────────
# When DRAFT_PREVIEW=1, unauthenticated GET browsing of /e/<slug>/*
# pages is ALLOWED IFF the event's meta.status === "draft". Published
# events still require login. Mutation routes (POST /api/rsvp/*,
# /api/auth/*, /api/cron/*) and the entire organizer surface
# (/internal/*, /api/internal/*) remain gated.
#
# Intended for CSL dry-runs and Vercel Preview deploys: a non-technical
# CSL can scaffold a draft event with the create-event skill and
# immediately preview the public pages without first standing up
# Supabase + Resend + Upstash + seeding an organizer invite.
#
# REFUSED in production (VERCEL_ENV="production") regardless of value.
# Leave unset in .env.local unless you're actively using the feature.
DRAFT_PREVIEW=
